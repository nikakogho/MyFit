# Runtime identity
MYFIT_ENV=development
MYFIT_OWNER_ID=00000000-0000-0000-0000-000000000000
LOG_LEVEL=info

# Public same-origin routes; safe to expose to the browser
VITE_PUBLIC_API_BASE_PATH=/api/public/v1
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_MCP_URL=http://localhost:8888/mcp

# Supabase server/operator configuration; values below are placeholders
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Cloudinary server/operator configuration; never expose API_SECRET to the browser
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-server-only-secret
